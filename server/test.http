@sara = PASTE_SARA_TOKEN_HERE
@omar = PASTE_OMAR_TOKEN_HERE

### 1. Login as Sara
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{ "email": "sara@test.com", "password": "123456" }

### 2. Login as Omar
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{ "email": "omar@test.com", "password": "123456" }

### 3. Sara creates a ticket
POST http://localhost:5000/api/tickets
Content-Type: application/json
Authorization: Bearer {{sara}}

{ "title": "Laptop won't connect to Wi-Fi", "description": "Dropped after the update", "category": "network", "priority": "high" }

### 4. Sara lists her tickets
GET http://localhost:5000/api/tickets
Authorization: Bearer {{sara}}

### 5. Omar lists all tickets
GET http://localhost:5000/api/tickets
Authorization: Bearer {{omar}}

### 6. Omar assigns ticket 1 to himself
PATCH http://localhost:5000/api/tickets/1/assign
Authorization: Bearer {{omar}}

### 7. Omar sets status
PATCH http://localhost:5000/api/tickets/1/status
Content-Type: application/json
Authorization: Bearer {{omar}}

{ "status": "in_progress" }

### 8. Omar comments
POST http://localhost:5000/api/tickets/1/comments
Content-Type: application/json
Authorization: Bearer {{omar}}

{ "body": "Reset the adapter, testing now." }

### 9. Ticket detail with comments
GET http://localhost:5000/api/tickets/1
Authorization: Bearer {{sara}}

### 10. Sara tries to change status (should be 403)
PATCH http://localhost:5000/api/tickets/1/status
Content-Type: application/json
Authorization: Bearer {{sara}}

{ "status": "resolved" }